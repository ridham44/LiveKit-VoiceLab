# ---------------------------------------------------------------------------
# Agent — LiveKit Agents worker process (STT/LLM/TTS pipeline)
# ---------------------------------------------------------------------------
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your-livekit-api-secret"
# Must match server/.env's LIVEKIT_AGENT_NAME — enables explicit dispatch (see agent.ts).
LIVEKIT_AGENT_NAME="voicelab-agent"

# Base URL of the @voicelab/server REST API (transcripts, metrics, tool calls, and knowledge-base
# search are all posted/fetched here as a call progresses).
SERVER_URL="http://localhost:4100"

# Provider keys — only the ones for providers actually selected in the active AgentConfig are
# used at runtime, but keys for providers you plan to test from the dashboard must be set here.
OPENAI_API_KEY=""
# OpenRouter can replace OpenAI, Deepgram, and the selected OpenAI-compatible
# TTS/STT endpoints. Put this in the root .env or agent/.env.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEEPGRAM_API_KEY=""
ELEVEN_API_KEY=""
CARTESIA_API_KEY=""
