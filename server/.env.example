# ---------------------------------------------------------------------------
# Server — REST API, Postgres, S3-compatible storage, LiveKit token issuance
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100

# Postgres. The docker-compose.yml at the repo root runs a local pgvector-enabled Postgres on
# 5434 by default — this matches that. Point at a managed Postgres (with the `vector` extension
# installed) in production.
DATABASE_URL="postgresql://voicelab:voicelab@localhost:5434/voicelab?schema=public"

# LiveKit project credentials. Get these from a LiveKit Cloud project (https://cloud.livekit.io)
# or your self-hosted LiveKit server. NEVER expose LIVEKIT_API_SECRET to the browser — only the
# server uses it, to mint short-lived room-join tokens for the client.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your-livekit-api-secret"
# Must match agent/.env's LIVEKIT_AGENT_NAME — used for explicit agent dispatch.
LIVEKIT_AGENT_NAME="voicelab-agent"

# Provider keys used server-side (knowledge base embeddings via OpenAI; weather tool). The agent
# process has its own copy in agent/.env for the STT/LLM/TTS it runs — keys are never shared
# with or sent to the browser.
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
ELEVEN_API_KEY=""
CARTESIA_API_KEY=""
# Optional: https://openweathermap.org/api — if unset, the weather tool uses Open-Meteo
# (api.open-meteo.com), which is free and keyless but slightly less detailed.
OPENWEATHER_API_KEY=""

# S3-compatible object storage for uploaded knowledge-base documents. The docker-compose.yml
# runs a local MinIO instance matching these defaults — point at real AWS S3 / Cloudflare R2 /
# Backblaze B2 in production by changing the endpoint, region, and keys (S3_FORCE_PATH_STYLE
# should be "false" for AWS S3, "true" for MinIO/most S3-compatible providers).
S3_ENDPOINT="http://localhost:9010"
S3_REGION="us-east-1"
S3_BUCKET="voicelab-knowledge"
S3_ACCESS_KEY_ID="voicelab"
S3_SECRET_ACCESS_KEY="voicelab123"
S3_FORCE_PATH_STYLE=true

# Origin allowed to call this API (the Vite dev server by default).
CORS_ORIGIN="http://localhost:5173"
