{
  "name": "@voicelab/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && node dist/index.js",
    "build": "node init && tsc -p tsconfig.json && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/lib-storage": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@voicelab/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.18.0",
    "mammoth": "^1.12.2",
    "multer": "^2.0.2",
    "openai": "^6.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
